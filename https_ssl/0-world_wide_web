#!/usr/bin/env bash
# Displays information about the DNS records of subdomains of a domain
# shellcheck disable=SC2086
show_info() {
    dig "$2.$1" | grep -A1 'ANSWER SECTION:' | tail -1 | awk -v sub="$2" '{print "The subdomain " sub " is a " $4 " record and points to " $5}'
}
if [ -n "$2" ]; then
    show_info "$1" "$2"
else
    for sub in www lb-01 web-01 web-02; do
        show_info "$1" "$sub"
    done
fi
